{
  "name": "ludiary",
  "private": true,
  "version": "0.0.0",
  "description": "Ludiary - unified video game library manager",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --exclude '.claude/**' --exclude '**/node_modules/**'",
    "build:desktop": "pnpm --filter @ludiary/desktop run build",
    "build:installer": "pnpm --filter @ludiary/desktop run build:installer"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
